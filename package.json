{
  "name": "myfocusapp",
  "version": "1.0.3",
  "description": "My Focus Timer",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.myfocus.app",
    "productName": "工作休息钟",
    "directories": {
      "output": "dist-app"
    },
    "win": {
       "icon": "icon.ico",  
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "author": "就是我",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
